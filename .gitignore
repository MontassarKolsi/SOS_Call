# Dependencies and build output
**/node_modules/
**/dist/
**/dist-ssr/
**/coverage/
**/.vite/
**/*.tsbuildinfo

# Local environment files
**/.env
**/.env.*
!**/.env.example
!**/.env.*.example

# Generated compiler output accidentally written beside Prisma source
**/src/prisma/*.js
**/src/prisma/*.js.map
**/src/prisma/*.d.ts

# Logs and local OS files
**/*.log
**/npm-debug.log*
**/yarn-debug.log*
**/pnpm-debug.log*
**/.DS_Store
**/Thumbs.db
